<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AssemblyName>InterprocessMemory</AssemblyName>
    <RootNamespace>InterprocessMemory</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <DocumentationFile>..\bin\$(Configuration)\$(TargetFramework)\InterprocessMemory.xml</DocumentationFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Company>InterprocessMemory</Company>
    <Authors>zacala1</Authors>
    <Copyright>Copyright (c) 2024 zacala1</Copyright>

    <!-- NuGet Package Properties -->
    <PackageId>InterprocessMemory</PackageId>
    <Version>4.1.0</Version>
    <Title>InterprocessMemory</Title>
    <Description>Typed queues, messages, arrays, structured data, and raw memory shared safely between .NET processes.</Description>
    <PackageTags>shared-memory;ipc;high-performance;simd;lock-free;zero-allocation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/zacala1/InterprocessMemory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zacala1/InterprocessMemory</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReleaseNotes>Adds a net10.0 build next to net8.0, allows the Windows Global\ and Local\ prefixes in region names, makes StructuredMemory and SharedArray throw instead of waiting for their whole timeout when the calling thread already holds the write lock through another instance of the region, and includes field offsets in the fingerprint of generic structs with automatic layout. The region format is unchanged from version 3. See CHANGELOG.md.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\MIGRATION.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
