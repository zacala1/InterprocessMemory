<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AssemblyName>InterprocessMemory</AssemblyName>
    <RootNamespace>InterprocessMemory</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <DocumentationFile>..\bin\$(Configuration)\$(TargetFramework)\InterprocessMemory.xml</DocumentationFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Company>InterprocessMemory</Company>
    <Authors>zacala1</Authors>
    <Copyright>Copyright (c) 2024 zacala1</Copyright>

    <!-- NuGet Package Properties -->
    <PackageId>InterprocessMemory</PackageId>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Title>InterprocessMemory</Title>
    <Description>Typed queues, messages, arrays, structured data, and raw memory shared safely between .NET processes.</Description>
    <PackageTags>shared-memory;ipc;high-performance;simd;lock-free;zero-allocation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/zacala1/InterprocessMemory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zacala1/InterprocessMemory</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReleaseNotes>First release. Raw shared memory regions with a process-wide reader/writer lock, structured memory with schema versioning, shared arrays, single-producer byte streams and typed queues, and concurrent queues and message queues, for net8.0 and net10.0 on Windows and Linux. The region format is version 3. Compatibility with earlier builds is described in the Region format section of the README.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.111" PrivateAssets="All" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
